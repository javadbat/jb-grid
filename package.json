      "types": "./react/dist/index.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "repository": {
		"type": "git",
		"url": "git@github.com:javadbat/jb-grid.git"
  },
  "dependencies": {
    "jb-button":"^4.0.0",
    "jb-core":"^0.30.0",
    "jb-icons": "^2.1.0"
  }
}
