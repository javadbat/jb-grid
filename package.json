{
  "name": "jb-grid",
  "description": "grid web component",
  "type": "module",
  "author": {
		"name": "mohammad javad bathaei",
		"email": "javadbat@gmail.com"
	},
  "keywords": [
    "jb",
    "jb-grid",
    "table",
    "pagination",
    "web component",
    "react component"
  ],
  "version": "0.7.2",
  "bugs": "https://github.com/javadbat/jb-grid/issues",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "react/",
    "web-component/lib/",
    "web-component/dist/",
    "react/dist/"
  ],
  "main": "index.js",
  "types": "./web-component/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./web-component/dist/index.d.ts",
      "default": "./index.js"
    },
